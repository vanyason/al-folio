---
layout: default
---
<div class="post about-page">
  <article>
    <div class="about-header about-header--{% if page.profile and page.profile.align == 'left' %}left{% else %}right{% endif %}">
      {% if page.profile %}
        <aside class="about-profile-card about-profile-card--{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid rounded-circle profile-photo' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid profile-photo' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
            {% assign profile_alt = site.first_name | append: ' ' | append: site.last_name | append: ' — profile photo' %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile_alt
              cache_bust=true
            %}
          {% endif %}
          <h1 class="profile-name">
            {% if site.title == 'blank' %}
              <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
              {{ site.last_name }}
            {% else %}
              {{ site.title }}
            {% endif %}
          </h1>
          {% if page.subtitle %}
            <p class="profile-role">{{ page.subtitle }}</p>
          {% endif %}
          {% if page.profile.more_info %}
            <div class="profile-more-info">{{ page.profile.more_info }}</div>
          {% endif %}
          {% if page.social %}
            <div class="profile-social contact-icons">{% social_links %}</div>
            {% if site.contact_note %}
              <div class="profile-contact-note">{{ site.contact_note }}</div>
            {% endif %}
          {% endif %}
        </aside>
      {% endif %}

      <div class="about-content">
        <h2 class="about-section-title">About</h2>
        {{ content }}
      </div>
    </div>

    {% if page.announcements and page.announcements.enabled %}
      <hr class="about-divider">
      <section class="about-news">
        <h2 class="about-section-title">
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">Recent News</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <hr class="about-divider">
      <section class="about-selected-papers">
        <h2 class="about-section-title">
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

  </article>
</div>
