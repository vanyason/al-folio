---
layout: default
---
<div class="post contact-page">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% assign cv = site.data.cv.cv %}
    {% if cv.name or cv.label or cv.location or cv.email or cv.phone or cv.website or cv.address %}
      <ul class="contact-list">
        {% if cv.name %}
          <li class="contact-item">
            <i class="fa-solid fa-user contact-item-icon" aria-hidden="true"></i>
            <div class="contact-item-body">
              <span class="contact-item-label">Full Name</span>
              <span class="contact-item-value">{{ cv.name }}</span>
            </div>
          </li>
        {% endif %}
        {% if cv.label %}
          <li class="contact-item">
            <i class="fa-solid fa-briefcase contact-item-icon" aria-hidden="true"></i>
            <div class="contact-item-body">
              <span class="contact-item-label">Professional Title</span>
              <span class="contact-item-value">{{ cv.label }}</span>
            </div>
          </li>
        {% endif %}
        {% if cv.email %}
          <li class="contact-item">
            <i class="fa-solid fa-envelope contact-item-icon" aria-hidden="true"></i>
            <div class="contact-item-body">
              <span class="contact-item-label">Email (personal)</span>
              <a class="contact-item-value" href="mailto:{{ cv.email }}">{{ cv.email }}</a>
            </div>
          </li>
        {% endif %}
        {% if cv.work_email %}
          <li class="contact-item">
            <i class="fa-solid fa-envelope-open-text contact-item-icon" aria-hidden="true"></i>
            <div class="contact-item-body">
              <span class="contact-item-label">Email (work)</span>
              <a class="contact-item-value" href="mailto:{{ cv.work_email }}">{{ cv.work_email }}</a>
            </div>
          </li>
        {% endif %}
        {% if cv.phone %}
          <li class="contact-item">
            <i class="fa-solid fa-phone contact-item-icon" aria-hidden="true"></i>
            <div class="contact-item-body">
              <span class="contact-item-label">Phone</span>
              <span class="contact-item-value">{{ cv.phone }}</span>
            </div>
          </li>
        {% endif %}
        {% if cv.address %}
          <li class="contact-item">
            <i class="fa-solid fa-location-dot contact-item-icon" aria-hidden="true"></i>
            <div class="contact-item-body">
              <span class="contact-item-label">Location</span>
              <span class="contact-item-value">
                {% if cv.address.street %}{{ cv.address.street }}, {% endif %}
                {% if cv.address.institution %}{{ cv.address.institution }}, {% endif %}
                {% if cv.address.city %}{{ cv.address.city }}, {% endif %}
                {% if cv.address.region %}{{ cv.address.region }} {% endif %}
                {% if cv.address.postalCode %}{{ cv.address.postalCode }}{% endif %}
              </span>
            </div>
          </li>
        {% endif %}
        {% if cv.website %}
          <li class="contact-item">
            <i class="fa-solid fa-globe contact-item-icon" aria-hidden="true"></i>
            <div class="contact-item-body">
              <span class="contact-item-label">Website</span>
              <a class="contact-item-value" href="{{ cv.website }}" target="_blank" rel="noopener">{{ cv.website }}</a>
            </div>
          </li>
        {% endif %}
      </ul>
    {% endif %}

    {% assign trimmed_content = content | strip %}
    {% if trimmed_content != '' %}
      <div class="contact-extra">{{ content }}</div>
    {% endif %}

    {% if site.data.socials %}
      <div class="contact-page-social">{% social_links %}</div>
    {% endif %}
  </article>
</div>
