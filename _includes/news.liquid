<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    {% assign recent_cutoff = 10 %}
    {% assign split_older = false %}
    {% if include.limit == nil or include.limit == false %}
      {% if news_size > recent_cutoff %}
        {% assign split_older = true %}
        {% assign news_limit = recent_cutoff %}
      {% endif %}
    {% endif %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% for item in news limit: news_limit %}
          {% assign display_date = item.display_date | default: item.date %}
          <tr>
            <th scope="row" style="width: 20%">
              {% if item.display_date %}
                {{ display_date }}
              {% else %}
                {{ display_date | date: '%b %d, %Y' }}
              {% endif %}
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if split_older %}
      <details class="older-news">
        <summary>News Archive</summary>
        <div class="table-responsive">
          <table class="table table-sm table-borderless">
            {% for item in news offset: recent_cutoff %}
              {% assign display_date = item.display_date | default: item.date %}
              <tr>
                <th scope="row" style="width: 20%">
                  {% if item.display_date %}
                    {{ display_date }}
                  {% else %}
                    {{ display_date | date: '%b %d, %Y' }}
                  {% endif %}
                </th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </table>
        </div>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
